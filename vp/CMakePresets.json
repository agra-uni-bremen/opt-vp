{
  "version": 4,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release: optimised, asserts off. Use it to measure or to run a benchmark.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo: -O2 -g with asserts. Use it while changing the ISS.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    },
    {
      "name": "debug",
      "displayName": "Debug: no optimisation, full debug information.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer on a Debug build.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "ci",
      "displayName": "What CI builds: Release with every warning an error.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release"},
    {"name": "relwithdebinfo", "configurePreset": "relwithdebinfo"},
    {"name": "debug", "configurePreset": "debug"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "ci", "configurePreset": "ci"}
  ]
}
